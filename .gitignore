# --- Dependencies / build output ---
node_modules/
dist/
.vite/
src-tauri/target/
src-tauri/target_*/
src-tauri/gen/schemas/
native/**/target/

# Built backend: only its placeholder stays in git so Tauri's resource path
# exists on a fresh clone (scripts/build_backend.ps1 fills it in).
/backend-dist/*
!/backend-dist/backend/
/backend-dist/backend/*
!/backend-dist/backend/README.md

# Downloaded embeddable Python / get-pip.py
.cache/

# --- Python ---
# Local build of native/jarvis-disk (contains absolute build paths).
# CI produces a clean .pyd and ships it inside the installer.
/jarvis_disk.pyd
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# --- Application data (must never be committed) ---
conversations/
traces/
server/traces/
uploads/
_file_index/
.tmp/
memory_store.json
tasks_history.json
shared/location_cache.json

# --- Secrets ---
.env
.env.*
api_keys.json

# --- Logs ---
*.log

# --- Local toolchain overrides (machine-specific MSVC paths) ---
src-tauri/.cargo/config.toml

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
