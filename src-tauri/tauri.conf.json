{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Jarvis",
  "version": "0.1.0-beta.1",
  "identifier": "com.jarvis.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Jarvis",
        "url": "/",
        "width": 427,
        "height": 759,
        "resizable": false,
        "alwaysOnTop": false,
        "transparent": true,
        "decorations": false,
        "visible": true
      },
      {
        "label": "assistant",
        "title": "Assistant",
        "url": "/?view=assistant",
        "width": 1152,
        "height": 683,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "transparent": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "/?view=settings",
        "width": 600,
        "height": 759,
        "resizable": false,
        "alwaysOnTop": false,
        "transparent": true,
        "decorations": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jarvis",
    "copyright": "Copyright (c) 2026 Jarvis. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "A desktop AI assistant for Windows",
    "longDescription": "Jarvis is a desktop AI assistant: a compact orb that opens into a chat console with local tools for files, shell, search and disk analysis.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend-dist/backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
